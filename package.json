{
  "name": "clock-stopped-at-eleven",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --open /editor.html",
    "dev:editor:backend": "tsx watch scripts/editor-backend.mjs",
    "dev:editor:full": "concurrently \"pnpm dev:editor:backend\" \"pnpm dev:editor\"",
    "docker:up": "docker compose --profile full up --build",
    "docker:down": "docker compose --profile full down",
    "docker:clean": "docker compose --profile full down -v --remove-orphans",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
